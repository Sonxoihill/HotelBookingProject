    {
      "name": "09. Payment & VNPay Gateway (SCRUM-94)",
      "item": [
        {
          "name": "Tạo URL thanh toán VNPay (SCRUM-94 API 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payment/create-url?bookingId=1&amount=1540000",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "create-url"],
              "query": [
                {
                  "key": "bookingId",
                  "value": "1",
                  "description": "ID đơn đặt phòng vừa tạo (bắt buộc)"
                },
                {
                  "key": "amount",
                  "value": "1540000",
                  "description": "Số tiền cần thanh toán (VNĐ, tùy chọn - nếu bỏ trống sẽ lấy từ booking)"
                }
              ]
            },
            "description": "API 1 (SCRUM-94): Nhận bookingId và amount, băm HMAC-SHA512 với vnp_HashSecret, trả về URL thanh toán VNPay Sandbox để Frontend chuyển hướng khách hàng."
          },
          "response": [
            {
              "name": "200 Tạo URL thành công",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/payment/create-url?bookingId=1&amount=1540000",
                  "host": ["{{baseUrl}}"],
                  "path": ["payment", "create-url"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Tạo URL thanh toán VNPay thành công\",\n  \"data\": {\n    \"paymentUrl\": \"https://sandbox.vnpayment.vn/paymentv2/vpcpay.html?vnp_Amount=154000000&vnp_Command=pay&vnp_CreateDate=20261007223000&vnp_CurrCode=VND&vnp_IpAddr=127.0.0.1&vnp_Locale=vn&vnp_OrderInfo=Thanh+toan+dat+phong+%231&vnp_OrderType=other&vnp_ReturnUrl=http%3A%2F%2Flocalhost%3A8080%2Fapi%2Fv1%2Fpayment%2Fvnpay-return&vnp_TmnCode=CGXZLS0Z&vnp_TxnRef=1_1728315000000&vnp_Version=2.1.0&vnp_SecureHash=mock_hash\",\n    \"url\": \"https://sandbox.vnpayment.vn/paymentv2/vpcpay.html?vnp_Amount=154000000&vnp_Command=pay&vnp_CreateDate=20261007223000&vnp_CurrCode=VND&vnp_IpAddr=127.0.0.1&vnp_Locale=vn&vnp_OrderInfo=Thanh+toan+dat+phong+%231&vnp_OrderType=other&vnp_ReturnUrl=http%3A%2F%2Flocalhost%3A8080%2Fapi%2Fv1%2Fpayment%2Fvnpay-return&vnp_TmnCode=CGXZLS0Z&vnp_TxnRef=1_1728315000000&vnp_Version=2.1.0&vnp_SecureHash=mock_hash\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Webhook IPN nhận kết quả thanh toán từ VNPay (SCRUM-94 API 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payment/vnpay-ipn?vnp_Amount=154000000&vnp_BankCode=NCB&vnp_BankTranNo=VNP14123456&vnp_CardType=ATM&vnp_OrderInfo=Thanh+toan+dat+phong+%231&vnp_PayDate=20261007221355&vnp_ResponseCode=00&vnp_TmnCode=CGXZLS0Z&vnp_TransactionNo=14123456&vnp_TransactionStatus=00&vnp_TxnRef=1_1728315000000&vnp_SecureHash=mock_hash",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "vnpay-ipn"],
              "query": [
                {
                  "key": "vnp_Amount",
                  "value": "154000000"
                },
                {
                  "key": "vnp_BankCode",
                  "value": "NCB"
                },
                {
                  "key": "vnp_BankTranNo",
                  "value": "VNP14123456"
                },
                {
                  "key": "vnp_CardType",
                  "value": "ATM"
                },
                {
                  "key": "vnp_OrderInfo",
                  "value": "Thanh toan dat phong #1"
                },
                {
                  "key": "vnp_PayDate",
                  "value": "20261007221355"
                },
                {
                  "key": "vnp_ResponseCode",
                  "value": "00",
                  "description": "00: Thành công, khác 00 (ví dụ 24): Hủy/Thất bại"
                },
                {
                  "key": "vnp_TmnCode",
                  "value": "CGXZLS0Z"
                },
                {
                  "key": "vnp_TransactionNo",
                  "value": "14123456"
                },
                {
                  "key": "vnp_TransactionStatus",
                  "value": "00"
                },
                {
                  "key": "vnp_TxnRef",
                  "value": "1_1728315000000",
                  "description": "Mã tham chiếu đơn hàng {bookingId}_{timestamp}"
