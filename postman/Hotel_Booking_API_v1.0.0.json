  "item": [
    {
      "name": "1. Khách Hàng (Customer)",
      "description": "Phân hệ Khách hàng (UC01 - UC08): Đăng ký, Đăng nhập, Tìm kiếm phòng, Xem chi tiết phòng, Đặt phòng, Thanh toán VNPay, Lịch sử đơn, Hủy đơn và Đánh giá phòng.",
      "item": [
        {
          "name": "POST /auth/register (Đăng ký tài khoản - UC01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    var token = jsonData.data ? jsonData.data.token : jsonData.token;",
                  "    if (token) {",
                  "        pm.environment.set(\"jwt_token\", token);",
                  "        console.log(\"JWT Token synced: \" + token);",
                  "    }",
                  "}",
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Khách\",\n  \"email\": \"khachhangmoi@gmail.com\",\n  \"password\": \"<YOUR_PASSWORD>\",\n  \"confirmPassword\": \"<YOUR_PASSWORD>\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản khách hàng mới với vai trò mặc định CUSTOMER (UC01)."
          },
          "response": []
        },
